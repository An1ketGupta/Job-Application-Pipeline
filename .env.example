# Copy this file to .env at the repository root.
# Local development services from docker-compose.yml
DATABASE_URL=postgresql://careerlift:careerlift@localhost:5432/careerlift?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
# Set a random local secret shared by the API and worker.
INSPECTION_AUTH_SECRET=

# Leave source URLs empty to use demo jobs.
CAREERLIFT_API_URL=
CAREERLIFT_API_KEY=
CAREERLIFT_MCP_URL=
CAREERLIFT_MCP_QUERY=
CAREERLIFT_MCP_LOCATION=
CAREERLIFT_MCP_TYPE=
CAREERLIFT_MCP_MAX_PAGES=1

OPENAI_API_KEY=
EMAIL_PROVIDER_API_KEY=
GEMINI_API_KEY=
ANSWER_PROVIDER=NONE
ANSWER_CONFIDENCE_THRESHOLD_PERCENT=75
BROWSER_HEADLESS=true
EXECUTION_ALLOW_REAL=false
EXECUTION_AUTO_SUBMIT=false
# Applications prepared before this activation time are not submitted automatically.
EXECUTION_AUTO_SUBMIT_SINCE=
EXECUTION_DOCUMENT_ROOT=./documents

# Optional Gmail OAuth; pnpm email:configure creates a local encryption key.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3001/api/v1/email/oauth/callback
EMAIL_WEB_ORIGIN=http://localhost:3000
EMAIL_ENCRYPTION_KEY=
EMAIL_ALLOW_SEND=false
EMAIL_EXPECTED_SENDER=
EMAIL_DEFAULT_SENDER_NAME=
EMAIL_TEST_RECIPIENT=
EMAIL_GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Google Forms integration; replace the example with your account.
GOOGLE_FORMS_ENABLED=false
GOOGLE_FORMS_ACCOUNT=you@example.com
ASHBY_BROWSER_ASSISTED_ENABLED=true
GREENHOUSE_BROWSER_ASSISTED_ENABLED=true
