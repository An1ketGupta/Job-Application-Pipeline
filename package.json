{
  "name": "careerlift-job-application-agent",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "test:greenhouse": "vitest run packages/browser/src/greenhouse.test.ts apps/api/src/greenhouse.test.ts apps/worker/src/greenhouse-preparation.test.ts",
    "typecheck:greenhouse": "tsc --noEmit -p tsconfig.greenhouse-tests.json",
    "test:ashby": "vitest run packages/browser/src/ashby-execution.test.ts apps/api/src/ashby-execution.test.ts apps/worker/src/automatic-execution.test.ts",
    "test:ashby:e2e": "vitest run --config vitest.integration.config.ts apps/api/src/ashby-pipeline.integration.test.ts",
    "typecheck:ashby": "tsc --noEmit -p tsconfig.ashby-tests.json",
    "test:google-forms": "node scripts/google-forms-acceptance.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:execution-tests",
    "typecheck:execution-tests": "tsc --noEmit -p tsconfig.execution-tests.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm format:check",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:applications:e2e": "vitest run --config vitest.integration.config.ts apps/api/src/applications-workspace.integration.test.ts",
    "test:candidate:e2e": "vitest run --config vitest.integration.config.ts apps/api/src/candidate-e2e.integration.test.ts",
    "test:mvp:e2e": "node tests/scripts/mvp-e2e.mjs",
    "test:execution": "vitest run packages/browser/src/execution.test.ts packages/browser/src/execution-hardening.test.ts packages/domain/src/execution.test.ts apps/api/src/execution.test.ts",
    "test:execution:e2e": "node tests/scripts/execution-e2e.mjs",
    "test:verification": "vitest run packages/domain/src/verification.test.ts packages/browser/src/verification.test.ts",
    "test:verification:e2e": "node tests/scripts/verification-e2e.mjs",
    "dev:api": "pnpm --filter @careerlift/api dev",
    "dev:worker": "pnpm --filter @careerlift/worker dev",
    "dev:web": "pnpm --filter @careerlift/web dev",
    "db:generate": "pnpm --filter @careerlift/database db:generate",
    "db:migrate": "pnpm --filter @careerlift/database db:migrate",
    "db:deploy": "pnpm --filter @careerlift/database db:deploy",
    "email:configure": "node scripts/configure-email.mjs",
    "typecheck:email": "tsc --noEmit -p tsconfig.email.json && pnpm --filter @careerlift/web typecheck",
    "test:email": "vitest run packages/domain/src/email.test.ts packages/email/src/email.test.ts packages/email/src/personalization.test.ts",
    "test:email:e2e": "vitest run --config vitest.integration.config.ts apps/api/src/email.integration.test.ts"
  },
  "devDependencies": {
    "playwright": "^1.56.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
