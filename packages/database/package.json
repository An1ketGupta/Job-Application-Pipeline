{
  "name": "@careerlift/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:deploy": "node scripts/migrate.mjs --deploy"
  },
  "dependencies": {
    "@careerlift/domain": "workspace:*",
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "prisma": "^6.16.0"
  }
}
